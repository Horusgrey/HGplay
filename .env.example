# Copy to .env (already gitignored) and fill in before running anything live.
# heirbud_server.py reads these from the environment — nothing here is ever
# hardcoded in source, per Definition of Done #5 (encrypted/secured secrets).

# Requires X-API-Key on every mutating endpoint. Unset = no auth (fine for
# solo local use on your own machine; set this before exposing the server
# beyond localhost).
HEIRBUD_API_KEY=

# Comma-separated CORS allowlist. Default is localhost-only.
HEIRBUD_ORIGINS=http://localhost,http://127.0.0.1

# Your real domain once you have one — the QR code on every printed letter
# points here. Defaults to localhost, which is fine until you're ready to
# actually mail letters.
HEIRBUD_BASE_URL=http://localhost:8001

# Optional paid skip-trace provider key. Unset = skiptrace.py uses its mock
# (deterministic fake phone/email, flagged demo=True) — safe for development,
# not for real outreach.
SKIPTRACE_API_KEY=
